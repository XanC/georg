# Automatic HTTPS (Let's Encrypt) for $GEORG_ORIGIN_HOSTNAME; certificates persist
# in /data. This is the only name the instance may serve: CloudFront connects to it
# as the origin and sends Host: <origin domain> — never the viewer's Host, so a
# certificate for the public name could never be issued here. Without CloudFront,
# set GEORG_ORIGIN_HOSTNAME to the name pointed at the instance (e.g. Hostname).
{$GEORG_ORIGIN_HOSTNAME:georg.stpaulaustin.org} {
	encode zstd gzip
	reverse_proxy georg-web:8000
	header Strict-Transport-Security "max-age=31536000"
}
